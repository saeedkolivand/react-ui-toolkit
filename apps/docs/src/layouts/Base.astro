---
import "../styles/site.css";
// The library's own stylesheet. Imported AFTER the site system so the two
// token namespaces are unambiguous; they do not overlap by construction.
import "@crosskit-ui/styles";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CrossKit — one component library, every framework",
  description = "Accessible UI components with one behaviour core, one stylesheet, and first-class adapters for React, Vue, Svelte and Angular.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><text y='20' font-size='20'>◆</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Inter:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <nav class="top-nav">
      <div class="site-container">
        <a class="wordmark" href="/">CrossKit</a>
        <div class="nav-links">
          <a href="#components">Components</a>
          <a href="#frameworks">Frameworks</a>
          <a href="/storybook/">Storybook</a>
          <a href="https://github.com/saeedkolivand/crosskit">GitHub</a>
          <a class="btn btn-primary" href="#install">Get started</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container">
        <div class="row" style="justify-content: space-between; align-items: flex-start;">
          <div class="stack-sm">
            <div class="wordmark">CrossKit</div>
            <div>One behaviour core. Four frameworks. MIT licensed.</div>
          </div>
          <div class="row" style="gap: var(--site-xl);">
            <a href="https://github.com/saeedkolivand/crosskit">GitHub</a>
            <a href="https://www.npmjs.com/org/crosskit-ui">npm</a>
            <a href="/storybook/">Storybook</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
