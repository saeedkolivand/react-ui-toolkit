#!/bin/sh
# Commit message validation ONLY.
#
# This hook previously also ran typecheck + lint:fix + lint-staged + the full
# test suite. Across a 7-package monorepo that makes every commit take minutes,
# so formatting moved to pre-commit and correctness moved to CI, which runs the
# same turbo tasks with --affected and a warm cache.
npx commitlint --edit "$1"
