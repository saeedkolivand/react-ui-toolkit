* text=auto

# Prettier normalises to LF, so the working tree must be LF on every platform.
# Otherwise a Windows checkout (core.autocrlf=true) fails `npm run lint` with
# "Delete ␍" on every line of any extension missing from this list.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.prettierrc text eol=lf
